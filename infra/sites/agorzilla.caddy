# agorzilla.com: the agorilla checkout in /opt/sites/agorilla (git pull every 10 minutes by cron).
# Copy to /opt/sites/agorzilla.caddy; the main Caddyfile imports /srv/sites/*.caddy.
agorzilla.com, www.agorzilla.com {
	encode gzip
	root * /srv/sites/agorilla
	# the archive and summary made every 10 minutes by the agorzilla-latest service; the checkout's copies if missing
	@live {
		path /chain/latest.json /chain/archive.json /chain/archive.js
		file {
			root /srv/sites/agorilla-live
		}
	}
	handle @live {
		root * /srv/sites/agorilla-live
		header Cache-Control no-cache
		header Access-Control-Allow-Origin *
		file_server
	}
	# the evening photographs (agorzilla-shots service): evening-<n>-before/after.jpg and evenings.json
	handle_path /evenings/* {
		root * /srv/agorzilla-shots
		header Cache-Control "public, max-age=300"
		header Access-Control-Allow-Origin *
		file_server
	}
	# Déjà, the café cat: her own page at /cat/
	redir /cat /cat/ 308
	@public path / /index.html /assets/* /chain/* /cat/ /cat/index.html
	handle @public {
		header /chain/* Cache-Control no-cache
		header /chain/latest.json Access-Control-Allow-Origin *
		file_server
	}
	handle {
		respond 404
	}
}
