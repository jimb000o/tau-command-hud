# Copied to .env by setup.sh. Secrets (alert keys below) go only into .env on the server.
RELAY_DOMAIN=node.tauhud.com
# Pinned tau-testnet commit the node image is built from.
TAU_TESTNET_REF=668fbf4762f2eeb76b39975157d2e75af788d240
# Parallel compile jobs for tau-lang. Keep 1 on a 4 GB server: a single
# translation unit can need over 3 GB, and 2 jobs froze a CAX11.
TAU_BUILD_JOBS=1
# The node follows IDNI tau-testnet main by itself (follow/idni_follow.py, README "Node follows IDNI main"):
# 0 stops it (also: up follow off). Optional: IDNI_FOLLOW_QUIET=sat 12-17,tue 16-20,wed 14-18,thu 10-12
# (German time, no switch then), IDNI_FOLLOW_TRIAL_MINUTES=45, IDNI_FOLLOW_GENESIS_RETRY_MINUTES=120 (new genesis)
IDNI_FOLLOW=1
ALLOWED_ORIGINS=https://tauhud.com,https://www.tauhud.com,https://jimb000o.github.io
# Validator seat: true only after IDNI has added our key (README "Validator seat").
TAU_VALIDATOR=false
# Whether the network counts governance votes from non-validators. IDNI switched
# this off on 2026-11-01; set true again only if IDNI reopens it.
TAU_NETWORK_OPEN_GOVERNANCE=false
# Alerts (alerts/alerts.py). Each channel stays off while its keys are empty.
# Telegram: bot token from @BotFather; the bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@tauHUDcom
# Tau HUD in one group with Topics (alerts/tgnews.py): TELEGRAM_CHAT_ID names the group; `up telegram` makes a closed
# News topic for the posts and keeps its id in /state/telegram.json. Set this only to pick a topic by hand (0 = General).
TELEGRAM_NEWS_TOPIC=
# X: the four OAuth 1.0a keys of an X app with Read and Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_PROFILE_URL=https://x.com/TauHUDcom
# X bills every post ($0.015, $0.20 with a link): caps per day and month; X_LINKS=true adds links, X_SIM=false leaves out the simulation.
# The blog's one X post per article carries its link (the card shows the picture): X_BLOG_LINK=false posts it without.
#X_BLOG_LINK=true
# the site's news (new pages and features) carry their link on X too, without an uploaded picture: X_SITE_LINK=false posts them without.
#X_SITE_LINK=true
X_DAILY_CAP=5
X_MONTHLY_CAP=240
# a closer look at one page a day (assets/deepdives.json): DEEPDIVES=false stops it; X for every DEEPDIVE_X_EVERY-th one
#DEEPDIVE_HOUR=13
#DEEPDIVE_X_EVERY=2
# IDNI's progress of the day as ONE post (alerts/idni_digest.py, uses NEWS_AI_KEY): at IDNI_DIGEST_HOUR UTC, only on days
# IDNI merged real changes; X only on notable days. IDNI_DIGEST=false stops it; up idni shows the next one
#IDNI_DIGEST_HOUR=10
#IDNI_DIGEST_LANG_ALONE=false
# the Key Crier, White Rabbit Key's island day before, every morning: ISLAND_CRIER=false stops it
#ISLAND_HOUR=7
#ISLAND_X_EVERY_DAYS=1
# Agorzilla's own X account (alerts/agorzilla.py): the four keys of an app made while signed in as that account.
AGORZILLA_X_API_KEY=
AGORZILLA_X_API_SECRET=
AGORZILLA_X_ACCESS_TOKEN=
AGORZILLA_X_ACCESS_SECRET=
# Weekly recap image and newspaper: weekday 0 = Monday, hour in RECAP_TZ local time (summer and winter); RECAP_ENABLED=false turns it off.
RECAP_WEEKDAY=0
RECAP_HOUR=9
RECAP_TZ=Europe/Berlin
# Visitor numbers report (relay/visits.py): leave empty and the relay makes a key in /data/visits.key.
VISITS_KEY=
# Troll box on the HUD (relay/chat.py): CHAT_ENABLED=0 closes it; admin page https://node.tauhud.com/chat/admin?key=<CHAT_KEY>
# (empty: the relay makes a key in /data/chat.key); CHAT_BLOCK_WORDS=word1,word2 refuses more words.
CHAT_ENABLED=1

# Cruise ships at White Rabbit Key (relay/cruise.py): MS Dry Run Wednesdays 16:00, Queen Mempool Saturdays 14:00, German time.
# Simulated passengers, real test transactions (at most 12 a minute); logbook https://node.tauhud.com/cruise/log
# CRUISE_ENABLED=0 keeps every ship away (then run up)
#CRUISE_ENABLED=1

# The hack of the week (relay/hackweek.py): Thursdays 11:00 German time a real kind of attack (address poisoning first) is
# replayed with four simulated wallets against the wallet's take-back window; posted by alerts/hack_crier.py. 0 stops it.
#HACK_ENABLED=1

# No Memo's crew purse (relay/nomemo.py): the drop and its lookalike are made once in the relay's data volume; the purse
# pays each chapter's share (500 test AGRS) back to the wallet that claimed it, the crew's mark once, and the Tracer
# sends dust from the lookalike. NOMEMO_ENABLED=0 switches the purse off, NOMEMO_TRACER=0 only the dust.
#NOMEMO_ENABLED=1
#NOMEMO_TRACER=1

# The news line's watchtower (alerts/tickerwatch.py): warns only you, in a private chat with the alerts bot, when the HUD's
# news line has had nothing new for TICKER_STALE_DAYS days or IDNI's news stopped. Set the chat once with: up owner
#TICKER_WATCH=true
#TICKER_STALE_DAYS=7
#TICKER_OWNER_CHAT=
CHAT_KEY=
CHAT_BLOCK_WORDS=
# The troll box's AI moderator (relay/chatai.py): an Anthropic API key turns it on; it re-reads every posted message and
# removes what the word lists miss. CHAT_AI_DAILY caps the checks per day (cost ceiling).
CHAT_AI_KEY=
CHAT_AI_MODEL=claude-haiku-5-5
# IDNI news on the HUD's news line (alerts/devpulse.py): a language model writes one headline per new IDNI merge
# (a few cents a week). Empty NEWS_AI_KEY uses CHAT_AI_KEY; with neither, no IDNI news runs.
NEWS_AI_KEY=
NEWS_AI_MODEL=claude-sonnet-5-5
CHAT_AI_DAILY=3000
# Every answer of the Anthropic API (troll box check, IDNI news, blog drafts) is measured (alerts/ai_meter.py): the
# "anthropic:" line of up and the monthly costs post show what last month cost. The bill: platform.claude.com/settings/billing
# Public P2P address other nodes dial (multiaddr). Default: this server's IPv4 on 4001.
# TAU_ANNOUNCE_ADDRS=/ip4/2.31.101.42/tcp/4001
# WebSocket connections one address may hold at once (every open page holds 2 to 4). Default 96.
# MAX_PER_IP=96
# Rico's voice in White Rabbit Key (rico/make.py): an ElevenLabs API key; the clips are made once by hand, see infra/README.md.
ELEVENLABS_API_KEY=
# The paintings of White Rabbit Key (infra/rabbit-art/paint.py): a Google AI Studio key. Nothing calls Gemini by itself;
# it paints only when asked (up island/room/touch/keep/bust, paint.sh), plus one short look at a newly painted room.
# Every call is measured (gemini-usage.json, the "gemini:" line of up, the monthly costs post); GEMINI_MONTH_CAP stops
# painting once a month's measured costs reach that many US dollars (0 = no Gemini calls at all).
# GEMINI_API_KEY=
# GEMINI_MONTH_CAP=10
# Kling, the AI video maker (alerts/kling.py): one API key (or Kling's access + secret key pair). Without it every post
# goes out with its still picture. KLING_MONTH_CAP clips a month for all uses; KLING_USES leaves uses out.
# KLING_API_KEY=
# KLING_MONTH_CAP=30

# The crew's ship log (alerts/crewlog.py): a members-only post in the Tau HUD crew on Fourthwall every Monday.
# The shop's API user: Fourthwall, Settings, For developers, Open API, Create API User. up crewlog on / off sets CREWLOG_ENABLED.
FOURTHWALL_API_USER=
FOURTHWALL_API_PASS=
CREWLOG_ENABLED=false
