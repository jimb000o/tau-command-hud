# Copied to .env by setup.sh. Secrets (alert keys below) go only into .env on the server.
RELAY_DOMAIN=node.tauhud.com
# Pinned tau-testnet commit the node image is built from.
TAU_TESTNET_REF=b1ebfa479dafe8f64ad741f1f101f2319db5eae4
# Parallel compile jobs for tau-lang. Keep 1 on a 4 GB server: a single
# translation unit can need over 3 GB, and 2 jobs froze a CAX11.
TAU_BUILD_JOBS=1
ALLOWED_ORIGINS=https://tauhud.com,https://www.tauhud.com,https://jimb000o.github.io
# Validator seat: true only after IDNI has added our key (README "Validator seat").
TAU_VALIDATOR=false
# Alerts (alerts/alerts.py). Each channel stays off while its keys are empty.
# Telegram: bot token from @BotFather; the bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@tauHUDcom
# X: the four OAuth 1.0a keys of an X app with Read and Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_PROFILE_URL=https://x.com/TauHUDcom
# X bills every post ($0.015, $0.20 with a link): caps per day and month; X_LINKS=true adds links, X_SIM=true the simulation.
X_DAILY_CAP=8
X_MONTHLY_CAP=120
# Agorzilla's own X account (alerts/agorzilla.py): the four keys of an app made while signed in as that account.
AGORZILLA_X_API_KEY=
AGORZILLA_X_API_SECRET=
AGORZILLA_X_ACCESS_TOKEN=
AGORZILLA_X_ACCESS_SECRET=
# Weekly recap image and newspaper: weekday 0 = Monday, hour in RECAP_TZ local time (summer and winter); RECAP_ENABLED=false turns it off.
RECAP_WEEKDAY=0
RECAP_HOUR=9
RECAP_TZ=Europe/Berlin
# Visitor numbers report (relay/visits.py): leave empty and the relay makes a key in /data/visits.key.
VISITS_KEY=
# Troll box on the HUD (relay/chat.py): CHAT_ENABLED=0 closes it; admin page https://node.tauhud.com/chat/admin?key=<CHAT_KEY>
# (empty: the relay makes a key in /data/chat.key); CHAT_BLOCK_WORDS=word1,word2 refuses more words.
CHAT_ENABLED=1
CHAT_KEY=
CHAT_BLOCK_WORDS=
# The troll box's AI moderator (relay/chatai.py): an Anthropic API key turns it on; it re-reads every posted message and
# removes what the word lists miss. CHAT_AI_DAILY caps the checks per day (cost ceiling).
CHAT_AI_KEY=
CHAT_AI_MODEL=claude-haiku-5-5
CHAT_AI_DAILY=3000
# Public P2P address other nodes dial (multiaddr). Default: this server's IPv4 on 4001.
# TAU_ANNOUNCE_ADDRS=/ip4/2.31.101.42/tcp/4001
# WebSocket connections one address may hold at once (every open page holds 2 to 4). Default 96.
# MAX_PER_IP=96
