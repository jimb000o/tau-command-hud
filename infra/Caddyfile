# TLS certificates come from Let's Encrypt automatically once the DNS record
# for {$RELAY_DOMAIN} points at this server.
{$RELAY_DOMAIN} {
	encode gzip
	# Rule Playground checks (checker/checker.py).
	handle /check* {
		request_body {
			max_size 16KB
		}
		reverse_proxy checker:8090
	}
	# Proposal tracker data, the Atom feed, the weekly recap images (alerts/alerts.py)
	# and the donation list read by About (alerts/donations.py).
	@alerts path /proposals.json /feed.xml /recap/* /donations.json
	handle @alerts {
		root * /srv/alerts
		header Access-Control-Allow-Origin *
		header Cache-Control "public, max-age=10"
		header /feed.xml Content-Type "application/atom+xml; charset=utf-8"
		file_server
	}
	# Share previews: link pictures and the link pages that carry them (share/share.py).
	@share path /og/* /s /s/*
	handle @share {
		reverse_proxy share:8070
	}
	# Everything else is the relay.
	handle {
		reverse_proxy relay:8080
	}
	# No access log: Caddy would write every visitor's address into the container log. Errors still reach
	# the container log (docker compose logs caddy); the privacy notice at tauhud.com/legal/ relies on this.
}

# More sites on this server: one <name>.caddy file each in /opt/sites on the host, with its files next to it.
# They are server-local and not part of this repository; an empty folder is fine.
import /srv/sites/*.caddy
