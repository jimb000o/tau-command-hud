# Copied to .env by install.sh; edit .env, then: docker compose up -d
# No secrets live here.

# Name shown on tauhud.com/stats under "community nodes" (1-24 of A-Z a-z 0-9 . _ -).
# Empty: the node does not report anywhere.
NODE_NAME=
# Your own public relay at wss://<PUBLIC_DOMAIN> (needs a DNS A record and ports 80/443).
# Set both lines, or leave both empty.
PUBLIC_DOMAIN=
COMPOSE_PROFILES=
# Pinned tau-testnet commit; install.sh keeps it equal to tauhud.com's (../infra/.env.example).
TAU_TESTNET_REF=
# Parallel compile jobs for the one-time tau-lang build: 1 on 4 GB RAM, 2 from 8 GB.
TAU_BUILD_JOBS=1
# true only after your key was added to the validator set (README "Validator").
TAU_VALIDATOR=false
